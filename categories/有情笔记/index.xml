&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> &lt;span class="n">outputs&lt;/span> &lt;span class="o">=&lt;/span> &lt;span class="bp">self&lt;/span>&lt;span class="o">.&lt;/span>&lt;span class="n">quantize&lt;/span>&lt;span class="p">(&lt;/span>&lt;span class="n">inputs&lt;/span>&lt;span class="p">,&lt;/span> &lt;span class="s2">&amp;#34;noise&amp;#34;&lt;/span> &lt;span class="k">if&lt;/span> &lt;span class="n">training&lt;/span> &lt;span class="k">else&lt;/span> &lt;span class="s2">&amp;#34;dequantize&amp;#34;&lt;/span>&lt;span class="p">,&lt;/span> &lt;span class="n">means&lt;/span>&lt;span class="p">)&lt;/span>
